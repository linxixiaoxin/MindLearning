    {
      "id": "高密度句 1",
      "type": "expression",
      "tagline": "不是所有反复发生的事都是命运，很多时候只是旧程序在自动运行。"
    },
    {
      "id": "高密度句 2",
      "type": "expression",
      "tagline": "真正要处理的，不是某一次情绪，而是这次情绪背后的模组。"
    },
    {
      "id": "高密度句 3",
      "type": "expression",
      "tagline": "关系、事业、金钱和身体，可能是同一组木马在不同场域里的显形。"
    },
    {
      "id": "高密度句 4",
      "type": "expression",
      "tagline": "一旦看见程序，就已经开始松动程序。"
    },
    {
      "id": "高密度句 5",
      "type": "expression",
      "tagline": "你以为自己在选择，其实可能只是旧频率在替你做决定。"
    },
    {
      "id": "高密度句 6",
      "type": "expression",
      "tagline": "焦虑不是爱，控制也不是负责。"
    },
    {
      "id": "高密度句 7",
      "type": "expression",
      "tagline": "天赋不是没有，而是可能被“应该先怎样”的声音盖住了。"
    },
    {
      "id": "高密度句 8",
      "type": "expression",
      "tagline": "身体有时不是在背叛你，而是在替你说出被忽略的需要。"
    },
    {
      "id": "高密度句 9",
      "type": "expression",
      "tagline": "扫描模组不是为了审判自己，而是为了找回选择权。"
    },
    {
      "id": "高密度句 10",
      "type": "expression",
      "tagline": "从玩家到创造者，中间差的不是更用力，而是先看清自己在跑什么。"
    }
