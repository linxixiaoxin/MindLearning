    },
    {
      "id": "为什么资本总要寻找新的空间和新的生活领域？",
      "type": "question",
      "tagline": "核心问题 1"
    },
    {
      "id": "为什么城市化既能吸纳过剩资本，也会制造新的不平等？",
      "type": "question",
      "tagline": "核心问题 2"
    },
    {
      "id": "为什么金融和债务能延缓危机，又会放大危机？",
      "type": "question",
      "tagline": "核心问题 3"
    },
    {
      "id": "为什么个人生活压力常常是空间结构和制度安排的结果？",
      "type": "question",
      "tagline": "核心问题 4"
    },
    {
      "id": "世界的逻辑",
      "type": "question",
      "tagline": "现代世界的许多生活压力，不是个人选择的孤立结果，而是资本、空间和制度共同塑造的结果。"
    },
    {
      "id": "资本通过空间移动转移危机",
      "type": "question",
      "tagline": "当既有场域难以继续增值，资本会转向城市、基础设施和全球扩张。"
    },
    {
      "id": "城市是资本积累的空间机器",
      "type": "question",
      "tagline": "城市化既创造生活便利，也吸纳过剩资本并重排阶层关系。"
    },
    {
      "id": "金融化把未来变成当下的交易对象",
      "type": "question",
      "tagline": "债务和资产价格让未来收益提前进入今天的资本循环。"
    },
    {
      "id": "空间不平等不是地理偶然",
      "type": "question",
      "tagline": "中心和边缘、繁荣和衰败常常是同一套积累逻辑的两面。"
    },
    {
      "id": "城市权利是重新讨论生活的入口",
      "type": "question",
      "tagline": "谁能决定城市如何建设，谁就影响了生活机会如何分配。"
    },
    {
      "id": "逻辑链 1",
      "type": "logic",
      "tagline": "资本积累需要不断扩张。"
    },
    {
      "id": "逻辑链 2",
      "type": "logic",
      "tagline": "扩张遇到瓶颈时，会通过城市、基础设施、房地产和全球化寻找新出口。"
    },
    {
      "id": "逻辑链 3",
      "type": "logic",
      "tagline": "空间修复能暂时吸纳过剩资本，却会把危机转移到新的地区、阶层和未来时间。"
    },
    {
      "id": "逻辑链 4",
      "type": "logic",
      "tagline": "金融化把未来收入提前打包，制造繁荣感，也积累脆弱性。"
    },
    {
      "id": "逻辑链 5",
      "type": "logic",
      "tagline": "掠夺式积累通过土地、资源、公共服务和债务重新分配财富。"
    },
    {
      "id": "逻辑链 6",
      "type": "logic",
      "tagline": "城市权利和生态边界成为理解现代世界矛盾的重要入口。"
    },
