    },
    {
      "id": "高敏感是种天赋Ⅱ",
      "type": "question",
      "tagline": "高敏感和内向不是缺陷，而是一种需要被理解、照顾和正确安放的气质结构。"
    },
    {
      "id": "敏感不是脆弱而是高反应性",
      "type": "question",
      "tagline": "高敏感者不是小题大做，而是神经系统更容易接收和放大刺激。"
    },
    {
      "id": "能量边界比意志力更重要",
      "type": "question",
      "tagline": "高敏感者的稳定来自输入管理、恢复空间和节奏安排，而不是一直硬撑。"
    },
    {
      "id": "内观给思维留下呼吸空间",
      "type": "question",
      "tagline": "观察念头、感受和身体反应，可以让人从刺激中退一步。"
    },
    {
      "id": "边界表达可以温和但清楚",
      "type": "question",
      "tagline": "说不、放慢回应和提出需求，不必以攻击或消失的方式完成。"
    },
    {
      "id": "不为合群牺牲真实自我",
      "type": "question",
      "tagline": "高敏感和内向者不需要用持续伪装换取接纳。"
    },
    {
      "id": "高敏感者需要意义感而不只是减压",
      "type": "question",
      "tagline": "找到快乐、意义和价值方向，才能让生活重新有支点。"
    },
    {
      "id": "逻辑链 1",
      "type": "logic",
      "tagline": "高敏感和内向是气质结构，不是人格失败。"
    },
    {
      "id": "逻辑链 2",
      "type": "logic",
      "tagline": "这些气质会带来更强的感知力，也带来更高的刺激负荷。"
    },
    {
      "id": "逻辑链 3",
      "type": "logic",
      "tagline": "稳定生活需要先管理输入、节奏和恢复空间。"
    },
    {
      "id": "逻辑链 4",
      "type": "logic",
      "tagline": "关系中的痛苦常来自过度迎合和需求被压下。"
    },
    {
      "id": "逻辑链 5",
      "type": "logic",
      "tagline": "边界表达和低消耗社交能减少长期伪装。"
    },
    {
      "id": "逻辑链 6",
      "type": "logic",
      "tagline": "最终目标不是成为外向者，而是活出真实、稳定、有意义的自己。"
    },
