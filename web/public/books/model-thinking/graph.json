    },
    {
      "id": "全书结构",
      "type": "summary",
      "tagline": "主问题、核心转向、最终落点和章节推进。"
    },
    {
      "id": "为什么复杂现实不能只靠单一模型或常识解释？",
      "type": "question",
      "tagline": "核心问题 1"
    },
    {
      "id": "模型到底能帮我们做哪些事，为什么它不仅用于预测？",
      "type": "question",
      "tagline": "核心问题 2"
    },
    {
      "id": "所谓多模型思维，和记住很多模型名词有什么本质不同？",
      "type": "question",
      "tagline": "核心问题 3"
    },
    {
      "id": "当问题涉及人、互动、网络和系统时，哪些模型最值得优先调用？",
      "type": "question",
      "tagline": "核心问题 4"
    },
    {
      "id": "怎样把模型工具箱变成更清楚的判断，而不是新的认知负担？",
      "type": "question",
      "tagline": "核心问题 5"
    },
    {
      "id": "逻辑链 1",
      "type": "logic",
      "tagline": "复杂现实无法被常识、经验和单一故事稳定解释，所以需要更可推理的认知工具。"
    },
    {
      "id": "逻辑链 2",
      "type": "logic",
      "tagline": "模型是对现实的有意简化，它的价值在于抓住关键结构，让现象能够被比较和推演。"
    },
    {
      "id": "逻辑链 3",
      "type": "logic",
      "tagline": "模型不只用于预测，还用于推理、解释、设计、沟通、行动和探索，因此不能只用“准不准”评价模型。"
    },
    {
      "id": "逻辑链 4",
      "type": "logic",
      "tagline": "所有模型都有盲区，所以越依赖一个顺手模型，越容易把复杂现实看窄。"
    },
    {
      "id": "逻辑链 5",
      "type": "logic",
      "tagline": "真正的智慧，不是找到唯一正确模型，而是让多个模型彼此互补、彼此校正。"
    },
    {
      "id": "逻辑链 6",
      "type": "logic",
      "tagline": "一旦问题涉及人、组织和群体行为，就必须把激励、博弈、学习和网络一起放进分析。"
    },
    {
      "id": "逻辑链 7",
      "type": "logic",
      "tagline": "一旦问题进入长期演化，就必须进一步补看分布、随机过程、路径依赖、反馈和系统动力学。"
    },
    {
      "id": "逻辑链 8",
      "type": "logic",
      "tagline": "多模型思维最后升级的，不是记忆量，而是你看问题、比模型、做判断和选行动的方式。"
    },
    {
      "id": "Part 1：为什么需要模型思维",
      "type": "chapter",
      "tagline": "先解释为什么复杂世界不能只靠常识、经验和单一解释。"
    },
    {
      "id": "Part 2：模型的7大用途",
      "type": "chapter",
      "tagline": "把模型从“预测工具”扩展成更完整的认知工具箱。"
    },
    {
      "id": "Part 3：多模型思维",
      "type": "chapter",
      "tagline": "说明为什么复杂问题必须依赖模型组合，而不是单点解释。"
    },
    {
      "id": "Part 4：对人类行为者建模",
      "type": "chapter",
      "tagline": "把视角从静态现象推进到人、激励、互动和学习。"
    },
    {
      "id": "Part 5：模型工具箱与现实应用",
      "type": "chapter",
      "tagline": "把后半本的大量模型重新整理成几类最关键的观察维度，并完成全书收口。"
    },
    {
      "id": "模型",
      "type": "concept",
      "tagline": "模型是对现实的有意简化，用来抓住某类问题最关键的结构。"
    },
    {
      "id": "多模型思维",
      "type": "concept",
      "tagline": "用多个互补模型共同理解同一问题，而不是把世界塞进一个解释里。"
    },
    {
      "id": "智慧层次结构",
      "type": "concept",
      "tagline": "从数据到信息、从知识到智慧，层层上升的判断结构。"
    },
    {
      "id": "模型的7大用途",
      "type": "concept",
      "tagline": "模型可以用于推理、解释、设计、沟通、行动、预测和探索，而不只是算出一个结果。"
    },
    {
      "id": "激励",
      "type": "concept",
      "tagline": "行为者会根据收益、成本和约束调整行动方式。"
    },
    {
      "id": "博弈与战略互动",
      "type": "concept",
      "tagline": "当结果取决于多方如何同时行动时，就需要用互动视角而非单边视角理解问题。"
    },
    {
      "id": "网络",
      "type": "concept",
      "tagline": "个体之间的连接方式会改变信息、影响力和风险的传播路径。"
    },
    {
      "id": "分布",
      "type": "concept",
      "tagline": "分布模型关注现象不是怎样“平均存在”，而是怎样在不同位置、不同规模上展开。"
    },
    {
      "id": "路径依赖",
      "type": "concept",
      "tagline": "早期的小差异会通过累积和锁定效应塑造后续结果。"
    },
    {
      "id": "反馈",
      "type": "concept",
      "tagline": "系统中的结果会反过来影响下一轮行动，从而形成强化回路或平衡回路。"
    },
    {
      "id": "系统动力学",
      "type": "concept",
      "tagline": "通过反馈回路、积累量和延迟来理解系统随时间的变化。"
    },
    {
      "id": "先判断问题类型再选模型",
      "type": "method",
      "tagline": "面对复杂议题、组织问题、政策问题、市场变化或社会现象时。"
    },
    {
      "id": "至少用两个互补模型交叉校正",
      "type": "method",
      "tagline": "当一个解释看起来太顺、太完整、太令人安心时。"
    },
    {
      "id": "先问模型用途，再评价模型好坏",
      "type": "method",
      "tagline": "当讨论一个模型是否“有用”“有效”“靠谱”时。"
    },
    {
      "id": "一旦问题里有人，就补看激励、博弈与网络",
      "type": "method",
      "tagline": "分析团队、组织、平台、市场、政策与社会问题时。"
    },
    {
      "id": "一旦结果跨时间，就补看路径依赖、反馈与延迟",
      "type": "method",
      "tagline": "分析长期竞争、组织演化、制度锁定、平台发展和系统性失控时。"
    },
    {
      "id": "全书主动作",
      "type": "method",
      "tagline": "复杂现实中的判断为什么总会被单一解释带偏，以及人如何用多个模型更接近真实。"
    },
    {
      "id": "用「为什么需要模型思维」处理关键问题",
      "type": "method",
      "tagline": "为什么复杂问题会让常识和单一解释不断失灵？"
