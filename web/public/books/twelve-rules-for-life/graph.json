      "id": "全书结构",
      "type": "summary",
      "tagline": "主问题、核心转向、最终落点和章节推进。"
    },
    {
      "id": "人生十二法则",
      "type": "question",
      "tagline": "这本书把成长理解为在混乱中建立秩序、承担责任和追求意义。"
    },
    {
      "id": "站直不是姿势而是存在状态",
      "type": "question",
      "tagline": "一个人的身体姿态、社会位置和自我感受会互相影响。"
    },
    {
      "id": "像照顾别人一样照顾自己",
      "type": "question",
      "tagline": "很多人愿意为他人负责，却忽视了对自己生命的基本责任。"
    },
    {
      "id": "先把自己的房间整理好",
      "type": "question",
      "tagline": "批评世界之前，先处理自己可以承担的生活秩序。"
    },
    {
      "id": "追求意义而不是苟且",
      "type": "question",
      "tagline": "短期舒服常常会损害长期尊严，意义需要牺牲和延迟满足。"
    },
    {
      "id": "说真话或者至少别撒谎",
      "type": "question",
      "tagline": "谎言会让现实反馈失真，最终把人带进更大的混乱。"
    },
    {
      "id": "精确表达能削弱恐惧",
      "type": "question",
      "tagline": "模糊的痛苦会膨胀，准确命名能让人重新面对现实。"
    },
    {
      "id": "在苦难中仍要看见小善意",
      "type": "question",
      "tagline": "生活不只由灾难构成，也由能让人继续活下去的小片刻构成。"
    },
    {
      "id": "逻辑链 1",
      "type": "logic",
      "tagline": "世界同时包含秩序与混乱。"
    },
    {
      "id": "逻辑链 2",
      "type": "logic",
      "tagline": "人无法消除所有痛苦，但可以选择如何回应痛苦。"
    },
    {
      "id": "逻辑链 3",
      "type": "logic",
      "tagline": "责任让人从受害位置回到行动位置。"
    },
    {
      "id": "逻辑链 4",
      "type": "logic",
      "tagline": "真话和精确表达能减少自欺与关系混乱。"
    },
    {
      "id": "逻辑链 5",
      "type": "logic",
      "tagline": "意义比即时满足更能支撑长期生活。"
