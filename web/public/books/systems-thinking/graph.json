  "nodes": [
    {
      "id": "公开入口",
      "type": "topic",
      "tagline": "从公开入口进入整本书的问题地图。"
    },
    {
      "id": "全书摘要",
      "type": "summary",
      "tagline": "用短摘要和标准摘要快速把握整本书。"
    },
    {
      "id": "全书结构",
      "type": "summary",
      "tagline": "主问题、核心转向、最终落点和章节推进。"
    },
    {
      "id": "如何系统思考",
      "type": "question",
      "tagline": "系统思考的核心是从事件反应转向结构理解。"
    },
    {
      "id": "系统不是要素清单",
      "type": "question",
      "tagline": "真正决定系统行为的是要素之间的连接和共同目标。"
    },
    {
      "id": "反馈回路解释反复发生",
      "type": "question",
      "tagline": "很多反复问题不是没解决，而是被回路不断再生产。"
    },
    {
      "id": "延迟会制造错误判断",
      "type": "question",
      "tagline": "行动和结果之间有时间差，人容易在结果出现前改变策略。"
    },
    {
      "id": "存量和流量决定变化速度",
      "type": "question",
      "tagline": "看见积累量和变化率，才能理解为什么改变慢或快。"
    },
    {
      "id": "边界决定你看见什么",
      "type": "question",
      "tagline": "系统边界画得不同，责任、资源和方案都会改变。"
    },
    {
      "id": "杠杆点常在心智模式深处",
      "type": "question",
      "tagline": "改变结构之前，常要先改变人们默认的解释方式。"
    },
    {
      "id": "逻辑链 1",
      "type": "logic",
      "tagline": "现实难题常常不是单点原因，而是系统结构的结果。"
    },
    {
      "id": "逻辑链 2",
      "type": "logic",
      "tagline": "系统由要素、连接、目标和边界共同构成。"
    },
    {
      "id": "逻辑链 3",
      "type": "logic",
      "tagline": "反馈回路会让行为不断自我强化或自我调节。"
    },
    {
      "id": "逻辑链 4",
      "type": "logic",
      "tagline": "延迟会让行动效果晚于人的耐心，导致误判。"
    },
    {
      "id": "逻辑链 5",
      "type": "logic",
      "tagline": "杠杆点不一定在最显眼处，而在结构和心智模式中。"
    },
