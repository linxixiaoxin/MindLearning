# Supabase Auth (for user login / management).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
#
# These also need to be set in Netlify dashboard for the serverless functions:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Thought Partner AI provider.
#
# Recommended first local choice:
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
#
# Kimi / Moonshot alternative:
# AI_PROVIDER=kimi
# KIMI_API_KEY=sk-...
# KIMI_MODEL=kimi-k2.6
#
# OpenAI fallback:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
#
# Xiaomi / MiMo or another OpenAI-compatible provider:
# AI_PROVIDER=xiaomi
# XIAOMI_API_KEY=...
# XIAOMI_BASE_URL=https://...
# XIAOMI_MODEL=...
#
# Generic override supported by all providers:
# AI_API_KEY=...
# AI_BASE_URL=https://provider.example/v1
# AI_MODEL=provider-model-name
