    },
    {
      "id": "说服别人时越讲道理越没用",
      "type": "scenario",
      "tagline": "说服语言要改变框架，而不只是增加信息"
    },
    {
      "id": "真正会说话的人，不是反应快，而是先判断场景",
      "type": "expression",
      "tagline": "用户以为话术就是背句子"
    },
    {
      "id": "为什么你越讲道理，对方越不想听",
      "type": "expression",
      "tagline": "表达者把说服误解成信息量堆叠"
    },
    {
      "id": "一场好演讲不是讲完，而是让听众发生变化",
      "type": "expression",
      "tagline": "很多演讲有内容但没有主线"
    },
    {
      "id": "话术不是句子，是场景雷达",
      "type": "expression",
      "tagline": "对象、关系、目标、风险四个维度决定一句话怎么说"
    },
    {
      "id": "五册表达能力阶梯",
      "type": "expression",
      "tagline": "日常说话 -> 说服语言 -> 演讲表达 -> 棘手谈话 -> 思想传播"
    },
    {
      "id": "高密度句 1",
      "type": "expression",
      "tagline": "话术不是万能句式，而是场景策略。"
    },
    {
      "id": "高密度句 2",
      "type": "expression",
      "tagline": "表达的第一步不是开口，而是判断这是什么场景。"
    },
    {
      "id": "高密度句 3",
      "type": "expression",
      "tagline": "说服不是让对方输，而是让对方换一种理解路径。"
    },
    {
      "id": "高密度句 4",
      "type": "expression",
      "tagline": "演讲不是把内容说完，而是让听众带走一个想法。"
    },
    {
      "id": "高密度句 5",
      "type": "expression",
      "tagline": "越重要的话，越不能只靠临场发挥。"
    },
    {
      "id": "高密度句 6",
      "type": "expression",
      "tagline": "好的表达会同时处理内容、关系和行动。"
    }
  ],
