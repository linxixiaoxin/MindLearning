    {
      "id": "全书结构",
      "type": "summary",
      "tagline": "主问题、核心转向、最终落点和章节推进。"
    },
    {
      "id": "为什么过去靠经验也能成长，如今只靠经验越来越不够？",
      "type": "question",
      "tagline": "核心问题 1"
    },
    {
      "id": "什么是多元思维模型，它为什么能成为更好的决策依据？",
      "type": "question",
      "tagline": "核心问题 2"
    },
    {
      "id": "如何从读书、工作和实践中高效寻找并掌握思维模型？",
      "type": "question",
      "tagline": "核心问题 3"
    },
    {
      "id": "怎样把零散知识搭成一个可迁移、可调用的知识体系？",
      "type": "question",
      "tagline": "核心问题 4"
    },
    {
      "id": "面对复杂问题，怎样用更高层级的思考方式找到关键？",
      "type": "question",
      "tagline": "核心问题 5"
    },
    {
      "id": "逻辑链 1",
      "type": "logic",
      "tagline": "环境变化越快，单靠经验试错的成长方式成本越高、有效期越短。"
    },
    {
      "id": "逻辑链 2",
      "type": "logic",
      "tagline": "更好的成长方式不是知道更多，而是找到更好的决策依据，这些依据就是思维模型。"
    },
    {
      "id": "逻辑链 3",
      "type": "logic",
      "tagline": "有效策略可以从经验技巧、方法流程、学科原理和哲学视角四个层次不断追问加深。"
    },
    {
      "id": "逻辑链 4",
      "type": "logic",
      "tagline": "真正掌握模型，不靠背定义，而靠在场景中反复内化，最终形成模式识别与直觉判断。"
    },
    {
      "id": "逻辑链 5",
      "type": "logic",
      "tagline": "零散模型只有被放进跨学科知识体系里，才能真正形成全局理解力。"
    },
    {
      "id": "逻辑链 6",
      "type": "logic",
      "tagline": "面对复杂问题，关键不是同时解决所有问题，而是学会降维攻击、变换尺度和聚焦关键。"
    },
    {
      "id": "Chapter 01 引言",
      "type": "chapter",
      "tagline": "解释为什么传统经验决策在快速变化时代越来越不够用，并引出深度思考型成长。"
    },
    {
      "id": "Chapter 02 多元思维模型：终身学习者的利器",
      "type": "chapter",
      "tagline": "解释什么是多元思维模型，以及为什么它是深度思考的底层支撑。"
    },
    {
      "id": "Chapter 03 学习掌握思维模型的实战方法",
      "type": "chapter",
      "tagline": "给出如何寻找、学习、内化思维模型的实战方法。"
    },
    {
      "id": "Chapter 04 如何建立多元思维模型知识体系",
      "type": "chapter",
      "tagline": "解释为什么必须建立跨学科知识系统，以及这个系统怎么搭。"
    },
    {
      "id": "Chapter 05 综合运用多元思维模型解决复杂问题",
      "type": "chapter",
      "tagline": "把前面学到的模型、体系和思考方式，真正推进到复杂问题的处理中。"
    },
    {
      "id": "多元思维模型",
      "type": "concept",
      "tagline": "用来自不同学科的重要原理、规律和思考方式，作为分析和解决问题的决策依据。"
    },
    {
      "id": "深度思考型成长",
      "type": "concept",
      "tagline": "在快速变化环境中，通过洞察问题本质、调用已有规律来直击要害的成长方式。"
    },
    {
      "id": "思维模型的四个层次",
      "type": "concept",
      "tagline": "有效策略可分为经验技巧型、方法流程型、学科原理型、哲学视角型四个层次。"
    },
    {
      "id": "棱镜法",
      "type": "concept",
      "tagline": "把一个问题的有效答案不断向下追问，拆到不同层次，直到看到背后的原理与思考方式。"
    },
    {
      "id": "查字典法",
      "type": "concept",
      "tagline": "把书当成解决问题的工具箱，而不是必须从头到尾读完的对象，带着问题去查找相关模型。"
    },
    {
      "id": "关键词法",
      "type": "concept",
      "tagline": "先抓一本书要解决的核心问题，再找相关关键词及其关系，形成关键词网。"
    },
    {
      "id": "超一流学习法",
      "type": "concept",
      "tagline": "由“超”“一”“流”三个环节组成的模型内化路径，即从高手和案例中提炼模型、举一反三、多维实践，并最终训练成直觉。"
    },
    {
      "id": "模式识别",
      "type": "concept",
      "tagline": "通过长期训练，把复杂知识和经验打包内化后，快速识别问题整体特征与异常点的能力。"
    },
    {
      "id": "相似性",
      "type": "concept",
      "tagline": "在不同学科、不同场景之间看到更底层共同模式的能力。"
    },
    {
      "id": "结构化思维",
      "type": "concept",
      "tagline": "先从问题的全局结构和核心框架入手，再理解细节的思维方式。"
    },
