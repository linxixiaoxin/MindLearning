  "nodes": [
    {
      "id": "公开入口",
      "type": "topic",
      "tagline": "从公开入口进入整本书的问题地图。"
    },
    {
      "id": "全书摘要",
      "type": "summary",
      "tagline": "用短摘要和标准摘要快速把握整本书。"
    },
    {
      "id": "全书结构",
      "type": "summary",
      "tagline": "主问题、核心转向、最终落点和章节推进。"
    },
    {
      "id": "福格行为模型",
      "type": "question",
      "tagline": "改变不是靠责备自己，而是重新设计行为发生的条件。"
    },
    {
      "id": "B MAP 是行为发生公式",
      "type": "question",
      "tagline": "行为需要动机、能力和提示在同一时刻相遇。"
    },
    {
      "id": "愿望必须翻译成具体行为",
      "type": "question",
      "tagline": "“变健康”无法执行，“饭后走两分钟”才是行为。"
    },
    {
      "id": "降低难度比提高意志力更可靠",
      "type": "question",
      "tagline": "让行为足够容易，改变才有启动点。"
    },
    {
      "id": "提示决定行为何时发生",
      "type": "question",
      "tagline": "没有合适提示，再好的计划也容易停在脑子里。"
    },
    {
      "id": "微习惯用小动作打开改变通道",
      "type": "question",
      "tagline": "小到不会失败的动作能绕过拖延和自责。"
    },
    {
      "id": "庆祝让习惯被情绪固定",
      "type": "question",
      "tagline": "人会重复让自己感觉良好的行为。"
    },
    {
      "id": "行为设计先排查系统，不责备人格",
      "type": "question",
      "tagline": "失败时先看设计，而不是给自己贴懒惰标签。"
    },
    {
      "id": "逻辑链 1",
      "type": "logic",
      "tagline": "愿望不会直接改变生活，具体行为才会。"
    },
    {
      "id": "逻辑链 2",
      "type": "logic",
      "tagline": "行为发生取决于动机、能力和提示的同时出现。"
    },
    {
      "id": "逻辑链 3",
      "type": "logic",
      "tagline": "与其提高意志力，不如降低行为难度。"
    },
    {
      "id": "逻辑链 4",
      "type": "logic",
      "tagline": "微小行为更容易启动，并能积累身份感。"
    },
    {
      "id": "逻辑链 5",
      "type": "logic",
      "tagline": "庆祝和积极情绪会让习惯更容易留下来。"
    },
    {
