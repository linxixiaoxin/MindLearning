  "nodes": [
    {
      "id": "公开入口",
      "type": "topic",
      "tagline": "从公开入口进入整本书的问题地图。"
    },
    {
      "id": "全书摘要",
      "type": "summary",
      "tagline": "用短摘要和标准摘要快速把握整本书。"
    },
    {
      "id": "全书结构",
      "type": "summary",
      "tagline": "主问题、核心转向、最终落点和章节推进。"
    },
    {
      "id": "为什么很多人明明有道理，却在沟通中失去合作机会？",
      "type": "question",
      "tagline": "核心问题 1"
    },
    {
      "id": "怎样在表达自己时，不把对方推到防御位置？",
      "type": "question",
      "tagline": "核心问题 2"
    },
    {
      "id": "怎样把情绪、抱怨和分歧转成可执行的下一步？",
      "type": "question",
      "tagline": "核心问题 3"
    },
    {
      "id": "怎样在职场沟通中把事实、判断、风险和请求说清楚？",
      "type": "question",
      "tagline": "核心问题 4"
    },
    {
      "id": "沟通的方法",
      "type": "question",
      "tagline": "沟通的核心不是说赢别人，而是让关系、资源和行动持续流动。"
    },
    {
      "id": "沟通是无限游戏",
      "type": "question",
      "tagline": "一次沟通的目标不只是当下结果，还包括是否让下一次合作仍然可能。"
    },
    {
      "id": "好沟通先处理目标感",
      "type": "question",
      "tagline": "开口前先确认这次谈话要完成什么，才能避免情绪、信息和请求混在一起。"
    },
    {
      "id": "结构化倾听让对方被准确接住",
      "type": "question",
      "tagline": "倾听不是沉默，而是用复述、确认和追问帮助双方校准事实与期待。"
    },
    {
      "id": "把情绪和抱怨翻译成方案",
      "type": "question",
      "tagline": "成熟表达不是压抑情绪，而是把情绪背后的事实、影响、需求和下一步说出来。"
    },
    {
      "id": "关系维护型沟通不是讨好",
      "type": "question",
      "tagline": "维护关系不是牺牲自己，而是在表达边界时保留继续合作的通道。"
    },
    {
      "id": "职场沟通要把信息判断请求拆开",
      "type": "question",
      "tagline": "职场沟通的关键是让对方快速知道事实是什么、风险在哪里、需要他做什么。"
    },
    {
      "id": "逻辑链 1",
      "type": "logic",
      "tagline": "沟通不是单次胜负，而是长期关系中的无限游戏。"
    },
    {
      "id": "逻辑链 2",
      "type": "logic",
      "tagline": "无限游戏要求沟通者同时关心结果、关系和下一次合作的可能性。"
    },
    {
      "id": "逻辑链 3",
      "type": "logic",
      "tagline": "因此开口前必须先建立目标感，判断这次谈话要完成什么。"
    },
    {
      "id": "逻辑链 4",
      "type": "logic",
      "tagline": "目标感需要结构化倾听支持，先校准事实、期待和感受。"
    },
    {
      "id": "逻辑链 5",
      "type": "logic",
      "tagline": "表达时要把事实、感受、需求和行动请求拆开，减少误解和防御。"
    },
    {
      "id": "逻辑链 6",
      "type": "logic",
      "tagline": "在复杂场景中，沟通要转化为方案、共识和行动。"
    },
    {
      "id": "无限游戏",
      "type": "chapter",
      "tagline": "第01个主题单元聚焦“无限游戏”，用于把《沟通的方法》的核心对象拆成可引用的知识节点。"
    },
